<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1cfmjfl" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.34.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.7.0">
  <bpmn:process id="process-payments" name="Process payments" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Grant application recieved">
      <bpmn:outgoing>Flow_08y2mzh</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="Event_047zupu" name="Payment executed">
      <bpmn:incoming>Flow_0deaxiy</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Activity_09ulv2r" name="Send Email">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="charge-credit-card" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1qr6fqo</bpmn:incoming>
      <bpmn:outgoing>Flow_0deaxiy</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0deaxiy" sourceRef="Activity_09ulv2r" targetRef="Event_047zupu" />
    <bpmn:sequenceFlow id="Flow_1qr6fqo" sourceRef="Activity_0dsskcs" targetRef="Activity_09ulv2r" />
    <bpmn:sequenceFlow id="Flow_08y2mzh" sourceRef="StartEvent_1" targetRef="Activity_0dsskcs" />
    <bpmn:scriptTask id="Activity_0dsskcs" name="Prepare transaction">
      <bpmn:extensionElements>
        <zeebe:script expression="=total * 1.1" resultVariable="totalWithTax" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_08y2mzh</bpmn:incoming>
      <bpmn:outgoing>Flow_1qr6fqo</bpmn:outgoing>
    </bpmn:scriptTask>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="process-payments">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="182" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="159" y="145" width="84" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_047zupu_di" bpmnElement="Event_047zupu">
        <dc:Bounds x="592" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="588" y="145" width="45" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_0f7rzp6_di" bpmnElement="Activity_0dsskcs">
        <dc:Bounds x="270" y="80" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_1ekziyb_di" bpmnElement="Activity_09ulv2r">
        <dc:Bounds x="430" y="80" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_08y2mzh_di" bpmnElement="Flow_08y2mzh">
        <di:waypoint x="218" y="120" />
        <di:waypoint x="270" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_0deaxiy_di" bpmnElement="Flow_0deaxiy">
        <di:waypoint x="530" y="120" />
        <di:waypoint x="592" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1qr6fqo_di" bpmnElement="Flow_1qr6fqo">
        <di:waypoint x="370" y="120" />
        <di:waypoint x="430" y="120" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
